+        ...state,
+        timeoutCount: state.timeoutCount + 1,
+      };
+    case "record_thinking_time":
+      return {
+        ...state,
+        totalThinkingTime: state.totalThinkingTime + action.thinkingTime,
+      };
     default:
       return state;
   }
